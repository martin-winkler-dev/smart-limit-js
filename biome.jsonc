{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!**/*.md",
      "!!**/tests/fixtures", // might intentionally be malformatted
      "!!**/docs",
      "!!**/old",
      "!!**/*.old",
      "!!**/.claude",
      "!!**/.agents"
    ]
  },
  "formatter": {
    "enabled": true,
    "lineEnding": "lf",
    "indentStyle": "space",
    "indentWidth": 4,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useBlockStatements": "error",
        "useConsistentArrayType": {
          "level": "error",
          "options": { "syntax": "shorthand" }
        },
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": { "style": "type" }
        },
        "useShorthandFunctionType": "error",
        "useTemplate": "error",
        "noUselessElse": "error",
        "useCollapsedElseIf": "error",
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "conventions": [
              {
                "selector": { "kind": "const" },
                "formats": ["camelCase", "CONSTANT_CASE", "PascalCase"]
              },
              {
                "selector": { "kind": "function" },
                "formats": ["camelCase", "PascalCase"]
              },
              {
                "selector": { "kind": "typeMethod" },
                "formats": ["camelCase"]
              },
              {
                "selector": { "kind": "objectLiteralProperty" },
                "formats": ["camelCase", "CONSTANT_CASE"]
              },
              {
                "selector": { "kind": "typeProperty" },
                "formats": ["camelCase", "CONSTANT_CASE"]
              }
            ]
          }
        },
        "useImportType": "error",
        "useExportType": "error",
        "useNodejsImportProtocol": "error",
        "useConst": "error",
        "noParameterAssign": "error",
        "noNonNullAssertion": "error",
        "useThrowOnlyError": "error",
        "noDefaultExport": "error"
      },
      "nursery": {
        "useConsistentFunctionStyle": {
          "level": "error",
          "options": { "style": "declaration" }
        }
      },
      "suspicious": {
        "noExplicitAny": "error"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error",
        "noUndeclaredDependencies": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/tests/**", "**/__tests__/**", "**/*.test.*"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          },
          "style": {
            "noNonNullAssertion": "off",
            "useNamingConvention": "off" // test data might mirror external payloads
          }
        }
      }
    },
    {
      "includes": ["**/tests/types/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off" // type tests declare variables only to assert their types
          }
        }
      }
    },
    {
      "includes": ["**/*.config.*", "**/scripts/**"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "bracketSameLine": false,
      "expand": "auto",
      "operatorLinebreak": "after",
      "attributePosition": "auto"
    }
  },
  "json": {
    // Omitting "parser" defaults to allowComments: false for .json and allowComments: true for .jsonc
    "formatter": {
      "indentWidth": 2,
      "trailingCommas": "none"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
