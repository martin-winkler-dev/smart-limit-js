{
  "name": "smart-limit",
  "version": "0.1.0",
  "description": "Rate limiter and job runner for API calls: concurrency, requests/cost per window, retries, 429 pauses. Never throws.",
  "keywords": [
    "rate-limit",
    "rate-limiter",
    "rate-limiting",
    "throttle",
    "concurrency",
    "llm",
    "tokens",
    "cost",
    "retry",
    "queue"
  ],
  "author": "Martin Winkler",
  "license": "Apache-2.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martin-winkler-dev/smart-limit-js.git"
  },
  "bugs": {
    "url": "https://github.com/martin-winkler-dev/smart-limit-js/issues"
  },
  "homepage": "https://github.com/martin-winkler-dev/smart-limit-js#readme",
  "packageManager": "bun@1.4.2",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "bun": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && bun run build:types && bun run build:js",
    "build:types": "tsc --emitDeclarationOnly",
    "build:js": "bun build ./src/index.ts ./src/testing.ts --outdir ./dist --target node --format esm --packages external --sourcemap=linked --banner=\"/*! Copyright 2026 Martin Winkler. SPDX-License-Identifier: Apache-2.0 */\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && bun run test:types",
    "test": "bun test --only-failures && bun run test:types",
    "test:types": "tsc --noEmit -p tsconfig.test.json",
    "test:dist": "node tests/smoke/smoke.mjs && node tests/smoke/smoke.cjs",
    "test:package": "attw --pack . --profile esm-only",
    "coverage": "bun test --coverage",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "lint:ci": "biome ci --error-on-warnings .",
    "check": "bun run lint:ci && bun run test && bun run build && bun run test:dist && bun run test:package",
    "prepublishOnly": "bun run check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.14",
    "@types/bun": "^1.4.4",
    "@types/node": "^22.12.0",
    "bun-test-runner": "latest",
    "smartin": "latest",
    "typescript": "^7.0.2"
  }
}
